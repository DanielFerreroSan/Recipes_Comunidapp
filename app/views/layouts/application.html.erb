<!DOCTYPE html>
<html>
  <head>
    <title>RecipesComunidapp</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :stylesheets %>
  </head>

  <body>
    <%= link_to "Skip to main content", "#main-content", class: "visually-hidden-focusable" %>
    <header>
      <%= render "shared/navbar" %> <!-- 👈 Add this for navbar -->
    </header>

    <% if current_page?(root_path) %>
      <%= yield %>
    <% else %>
      <main id="main-content" class="<%= content_for?(:full_width) ? 'p-0 m-0' : 'container' %>">
        <%= yield %>
      </main>
    <% end %>
    <%= render "shared/flashes" %>
  </body>
</html>
