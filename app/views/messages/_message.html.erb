<% content_for :stylesheets do %>
  <style>

    .recipe-save-container {
      display: flex;
      justify-content: flex-end;
      margin-top: 10px;
    }

    .save-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #5A7D7C;
      border: 1px solid #5A7D7C;
      color: #fff;
      font-size: 14px;
      font-weight: 500;
      padding: 6px 12px;
      border-radius: 16px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .save-btn i {
      font-size: 15px;
      color: #E6F3E6;
    }

    .save-btn:hover {
      background: #E6F3E6;
      border-color: #cfd8cf;
      color: #2f3e2f;
    }

    .save-btn:hover i {
      color: #2f3e2f;
    }


    .save-btn:active {
      transform: translateY(1px);
    }

  </style>
<% end %>


<% is_assistant = message.role == "assistant" %>
<div class="message <%= is_assistant ? 'assistant' : 'user' %>">
  <div class="avatar">
    <% if is_assistant %>
      <div class="avatar-circle assistant-avatar">IA</div>
    <% else %>
      <div class="avatar-circle user-avatar">U</div>
    <% end %>
  </div>

  <div class="bubble-container">
    <div class="bubble">
      <%= markdown(message.content) %>

      <% if message.file.attached? %>
        <div class="mt-2">
          <strong>Archivo:</strong>
          <%= link_to message.file.filename, rails_blob_path(message.file, disposition: "attachment") %>
        </div>
      <% end %>

      <% if is_assistant && message.content.match(/^###\s*(.+)$/)&.captures&.first %>
        <% recipe_title = message.content.match(/^###\s*(.+)$/)&.captures&.first %>
        <% cat = RubyLLM.chat.with_instructions("Una sola palabra y nada más").ask("Dame una categoría para la receta: #{message.content}") %>
        <div class="recipe-save-container">
          <%= button_to recipes_path(
                recipe: {
                  name: recipe_title,
                  content: message.content,
                  category: cat.content,
                  chat_id: message.chat_id
                }),
                method: :post,
                class: "save-btn" do %>
              <i class="fa-regular fa-floppy-disk"></i>
              <span>Guardar receta</span>
          <% end %>
        </div>

      <% end %>
    </div>
  </div>
</div>
