<% content_for :stylesheets do %>
 <style>
    body {
      background: url("<%= asset_path('chat-background.png') %>") no-repeat center center fixed;
      background-size: cover;
      font-family: 'Poppins', sans-serif;
    }

    .devise-edit-wrapper {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 40px 15px;
    }


    .devise-edit-container {
      background-color: rgba(255, 255, 255, 0.9);
      border-radius: 20px;
      padding: 40px 50px;
      max-width: 800px;
      width: 100%;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
    }

    .devise-edit-container h2,
    .devise-edit-container h3 {
      text-align: center;
      color: #333;
      font-weight: 700;
      margin-bottom: 25px;
    }


    .devise-edit-container input[type="text"],
    .devise-edit-container input[type="email"],
    .devise-edit-container input[type="password"],
    .devise-edit-container input[type="number"],
    .devise-edit-container textarea,
    .devise-edit-container select {
      background-color: #fff !important;
      border: 1px solid #ccc;
      border-radius: 10px;
      padding: 10px 15px;
      width: 100%;
      box-sizing: border-box;
      transition: border-color 0.3s ease;
    }

    .devise-edit-container input:focus,
    .devise-edit-container textarea:focus,
    .devise-edit-container select:focus {
      border-color: #007bff;
      outline: none;
      box-shadow: 0 0 5px rgba(0, 123, 255, 0.3);
    }

    .devise-edit-container .form-actions {
      text-align: center;
      margin-top: 25px;
    }

    .devise-edit-container .form-actions .btn,
    .devise-edit-container input[type="submit"],
    .devise-edit-container button {
      background-color: #007bff;
      border: none;
      color: white;
      border-radius: 10px;
      padding: 10px 25px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.3s;
    }

    .devise-edit-container .form-actions .btn:hover,
    .devise-edit-container input[type="submit"]:hover,
    .devise-edit-container button:hover {
      background-color: #0056b3;
    }

    .devise-edit-container a {
      display: inline-block;
      margin-top: 15px;
      color: #007bff;
      text-decoration: none;
      font-weight: 500;
    }

    .devise-edit-container a:hover {
      text-decoration: underline;
    }
  </style>
<% end %>

<div class="devise-edit-wrapper">
  <div class="devise-edit-container">
    <h2>Log in</h2>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-inputs">
        <%= f.input :email,
                    required: false,
                    autofocus: true,
                    input_html: { autocomplete: "email" } %>
        <%= f.input :password,
                    required: false,
                    input_html: { autocomplete: "current-password" } %>
        <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
      </div>

      <div class="form-actions">
        <%= f.button :submit, "Log in" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
