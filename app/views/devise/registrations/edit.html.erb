<% content_for :stylesheets do %>
  <style>
    body {
      background: url("<%= asset_path('chat-background.png') %>") no-repeat center center fixed;
      background-size: cover;
      font-family: 'Poppins', sans-serif;
    }

    .devise-edit-wrapper {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 40px 15px;
    }


    .devise-edit-container {
      background-color: rgba(255, 255, 255, 0.9);
      border-radius: 20px;
      padding: 40px 50px;
      max-width: 800px;
      width: 100%;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
    }

    .devise-edit-container h2,
    .devise-edit-container h3 {
      text-align: center;
      color: #333;
      font-weight: 700;
      margin-bottom: 25px;
    }


    .devise-edit-container input[type="text"],
    .devise-edit-container input[type="email"],
    .devise-edit-container input[type="password"],
    .devise-edit-container input[type="number"],
    .devise-edit-container textarea,
    .devise-edit-container select {
      background-color: #fff !important;
      border: 1px solid #ccc;
      border-radius: 10px;
      padding: 10px 15px;
      width: 100%;
      box-sizing: border-box;
      transition: border-color 0.3s ease;
    }

    .devise-edit-container input:focus,
    .devise-edit-container textarea:focus,
    .devise-edit-container select:focus {
      border-color: #007bff;
      outline: none;
      box-shadow: 0 0 5px rgba(0, 123, 255, 0.3);
    }

    .devise-edit-container .form-actions {
      text-align: center;
      margin-top: 25px;
    }

    .devise-edit-container .form-actions .btn,
    .devise-edit-container input[type="submit"],
    .devise-edit-container button {
      background-color: #007bff;
      border: none;
      color: white;
      border-radius: 10px;
      padding: 10px 25px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.3s;
    }

    .devise-edit-container .form-actions .btn:hover,
    .devise-edit-container input[type="submit"]:hover,
    .devise-edit-container button:hover {
      background-color: #0056b3;
    }

    .devise-edit-container a {
      display: inline-block;
      margin-top: 15px;
      color: #007bff;
      text-decoration: none;
      font-weight: 500;
    }

    .devise-edit-container a:hover {
      text-decoration: underline;
    }

    .tag-container {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .tag {
      background-color: #e0e6e0;
      color: #333;
      border-radius: 20px;
      padding: 6px 14px;
      font-size: 0.9rem;
      cursor: pointer;
      transition: all 0.2s ease-in-out;
      border: 1px solid transparent;
      user-select: none;
    }

    .tag:hover {
      background-color: #cfe3cf;
    }

    .tag.active {
      background-color: #5A7D7C;
      color: white;
      border-color: #48625f;
    }


  </style>
<% end %>

<div class="devise-edit-wrapper">
  <div class="devise-edit-container">

    <h2>Editar usuario</h2>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= f.error_notification %>

      <div class="form-inputs">
        <%= f.input :email, required: true, autofocus: true %>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p>Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
        <% end %>

        <%= f.input :password,
                    hint: "Déjalo en blanco si no deseas cambiarlo",
                    required: false,
                    input_html: { autocomplete: "new-password" } %>
        <%= f.input :password_confirmation,
                    required: false,
                    input_html: { autocomplete: "new-password" } %>
        <%= f.input :current_password,
                    hint: "Necesitamos tu password actual para actualizar tus cambios",
                    required: true,
                    input_html: { autocomplete: "current-password" } %>
        <%= f.input :age,
                    hint: "Edad",
                    required: false,
                    input_html: { autocomplete: "age" } %>
        <%= f.input :gender,
                    as: :select,
                    collection: ["Masculino", "Femenino", "Otro"],
                    include_blank: "Selecciona tu género",
                    label: "Género",
                    selected: f.object.gender.presence,
                    required: false %>
        <%= f.input :activity,
                    hint: "Actividad física",
                    required: false,
                    input_html: { autocomplete: "activity" } %>
        <%= f.input :height,
                    hint: "Altura en cm",
                    required: false,
                    input_html: { autocomplete: "height" } %>
        <%= f.input :weight,
                    hint: "Peso en Kg",
                    required: false,
                    input_html: { autocomplete: "weight" } %>
        <div class="form-group">
          <label>Restricciones alimenticias</label>
          <p class="text-muted small mb-2">Selecciona todas las que apliquen:</p>

          <% user_restrictions = (f.object.restrictions || "").split(",").map(&:strip) %>

          <div id="restriction-tags" class="tag-container">
            <% all_restrictions = ["Vegetariano", "Vegano", "Sin lactosa", "Sin gluten", "Sin frutos secos", "Sin mariscos", "Otros"] %>
            <% all_restrictions.each do |r| %>
              <span class="tag <%= 'active' if user_restrictions.include?(r) %>" data-value="<%= r %>"><%= r %></span>
            <% end %>
          </div>

          <div id="other-restriction-container" class="mt-3" style="<%= user_restrictions.include?('Otros') ? '' : 'display: none;' %>">
            <label for="other-restriction" class="small text-muted">Especificar restricciones</label>
            <input type="text" id="other-restriction" class="form-control" placeholder="Especificar restricciones" value="<%= (user_restrictions - all_restrictions).join(', ') %>">
          </div>

          <%= f.hidden_field :restrictions, id: "restrictions-input", value: f.object.restrictions %>
        </div>


      </div>

      <div class="form-actions">
        <%= f.button :submit, "Actualizar datos" %>
      </div>
    <% end %>



    <div>
      Unhappy?
      <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete %>
    </div>

    <%= link_to "Back", :back %>
  </div>
</div>

