<script>
  document.addEventListener("turbo:load", () => {
    const tags = document.querySelectorAll(".tag");
    const input = document.getElementById("restrictions-input");
    const otherContainer = document.getElementById("other-restriction-container");
    const otherInput = document.getElementById("other-restriction");

    const updateInputValue = () => {
      let activeTags = Array.from(document.querySelectorAll(".tag.active"))
                            .map(t => t.dataset.value);
      if (activeTags.includes("Otros") && otherInput.value.trim() !== "") {
        activeTags.push(otherInput.value.trim());
      }
      input.value = activeTags.join(", ");
    };

    tags.forEach(tag => {
      tag.addEventListener("click", () => {
        tag.classList.toggle("active");

        if (tag.dataset.value === "Otros") {
          if (tag.classList.contains("active")) {
            otherContainer.style.display = "block";
          } else {
            otherContainer.style.display = "none";
            otherInput.value = "";
          }
        }

        updateInputValue();
      });
    });

    if (otherInput) {
      otherInput.addEventListener("input", updateInputValue);
    }
  });
</script>
