<div class="recipes-page">
<div class="mt-3 mb-3">
<div class="container body-recipes-page">
  <div class="mb-3">
<h1 class="titulo text-center fw-bold">Mis Recetas</h1>
    <%= form_with url: recipes_path, method: :get, local: true, class: "d-flex align-items-center flex-wrap gap-2 justify-content-center" do |form| %>

      <!-- Filtro por categoría -->
      <div class="d-flex align-items-center gap-2">
        <%= form.label :category, "Categoría:", class: "me-2 fw-semibold text-white" %>
        <%= form.select :category, options_for_select(@categories, params[:category]), include_blank: "Todas", class: "form-select rounded-4 border-1" %>
      </div>

      <!-- Filtro por rating -->
      <div class="d-flex align-items-center gap-2">
        <%= form.label :rating, "Rating mínimo:", class: "me-1   fw-semibold text-white" %>
        <%= form.select :rating, options_for_select((1..5).to_a, params[:rating]), include_blank: "Todos", class: "form-select rounded-4 border-1" %>
      </div>

      <%= form.submit "Filtrar", class: "btn btn-primary" %>
    <% end %>
  </div>

  <% if @recipes.any? %>
    <div class="row justify-content-center">
      <% @recipes.each do |recipe| %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card h-100 shadow-sm border-0 rounded-4" style="background-color: #f9f7f1;">
            <div class="card-body">
              <h4 class="card-title mb-2">
                <%= link_to recipe.name, recipe_path(recipe), class: "text-decoration-none text-dark fw-semibold" %>
              </h4>

              <p class="text-muted mb-2">
                <i class="bi bi-tag"></i>
                <strong>Categoría:</strong>
                <%= recipe.category.presence || "Sin categoría" %>
              </p>

              <p class="text-secondary mb-3">
                <%= truncate(recipe.content, length: 100, separator: ' ') %>
              </p>

              <!-- ⭐ Mostrar estrellas según el valor de recipe.rating -->
              <div class="mt-3 d-flex align-items-center">
                <% rating = recipe.rating || 0 %>
                <% 5.times do |i| %>
                  <% if i < rating %>
                    <i class="bi bi-star-fill text-warning fs-5"></i>
                  <% else %>
                    <i class="bi bi-star text-warning fs-5"></i>
                  <% end %>
                <% end %>
                <span class="ms-2 text-muted small">
                  <%= recipe.rating ? "#{recipe.rating}/5" : "Sin calificar" %>
                </span>
              </div>
            </div>

            <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center">
              <%= link_to "Ver", recipe_path(recipe),
                  class: "btn btn-sm btn-outline-primary rounded-pill px-3" %>

              <button class="btn btn-sm btn-outline-success rounded-pill px-3 btn-compartir"
                      data-nombre="<%= recipe.name %>"
                      data-url="<%= recipe_url(recipe) %>">
                <i class="bi bi-share"></i> Compartir
              </button>

              <%= link_to "Eliminar", recipe_path(recipe),
                  data: { turbo_method: :delete, turbo_confirm: "¿Estás seguro de eliminar esta receta?" },
                  class: "btn btn-sm btn-outline-danger rounded-pill px-3" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center text-muted fs-5 mt-5">
      <p>No tienes recetas guardadas todavía.</p>
    </div>
  <% end %>
</div>
</div>
</div>
<!-- Script para que los botones Compartir funcionen -->
<script>
  document.addEventListener("turbo:load", () => {
    document.querySelectorAll(".btn-compartir").forEach(btn => {
      btn.addEventListener("click", () => {
        const nombre = btn.dataset.nombre;
        const url = btn.dataset.url;

        if (navigator.share) {
          navigator.share({
            title: nombre,
            text: `Mira esta receta: ${nombre}`,
            url: url
          }).catch(err => console.error("Error al compartir:", err));
        } else {
          navigator.clipboard.writeText(url).then(() => {
            alert("🔗 Enlace copiado al portapapeles");
          }).catch(err => {
            console.error("Error al copiar enlace:", err);
            alert("No se pudo copiar el enlace");
          });
        }
      });
    });
  });
</script>
