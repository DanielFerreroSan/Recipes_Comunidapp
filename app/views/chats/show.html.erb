<% content_for :stylesheets do %>
  <style>
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: #f0f2f5;
      font-family: 'Inter', sans-serif;
    }

    .chat-layout {
      display: flex;
      flex-direction: column;
      height: calc(100vh - 56px); /* resta navbar */
      overflow: hidden;
      padding-bottom: 8px; /* margen inferior visual */
    }

    .chat-header {
      flex-shrink: 0;
      background: #f0f2f5;
      padding: 12px;
      border-bottom: 1px solid #ddd;
      text-align: center;
    }

    .chat-input {
      flex-shrink: 0;
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(10px);
      box-shadow: 0 -1px 10px rgba(0,0,0,0.08);
      padding: 8px 16px;
      margin-bottom: 8px;
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 10;
      position: relative;
    }

    /* Formulario interno */
    .chat-input form {
      max-width: 800px;
      width: 100%;
      display: flex;
      gap: 10px;
    }

    .chat-input textarea {
      flex: 1;
      border: 1px solid #ccc;
      border-radius: 12px;
      padding: 10px;
      resize: none;
      height: 45px;
      transition: all 0.2s;
    }

    .chat-input textarea:focus {
      border-color: #007bff;
      box-shadow: 0 0 5px rgba(0,123,255,0.3);
      outline: none;
    }

    .chat-input button {
      border: none;
      border-radius: 12px;
      background: #007bff;
      color: white;
      padding: 0 20px;
      cursor: pointer;
      font-weight: 600;
      transition: all 0.2s;
    }

    .chat-input button:hover {
      background: #0056b3;
    }

    /* ========== MENSAJES ========== */
    .chat-messages {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding: 24px 0; /* sin padding lateral para alinear al form */
      display: flex;
      flex-direction: column;
      align-items: center; /* centra la columna de conversación */
      gap: 20px;
      scroll-behavior: smooth;
      scrollbar-gutter: stable both-edges; /* scroll siempre en borde derecho */
    }

    /* contenedor individual del mensaje */


    /* ======== AVATARES ======== */
    .message {
      width: 100%;
      max-width: 800px;
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    /* avatar base */
    .avatar-circle {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      color: white;
      flex-shrink: 0;
    }

    /* colores de avatar */
    .user-avatar {
      background-color: #007bff;
    }

    .assistant-avatar {
      background-color: #6c757d;
    }

    /* contenedor de burbujas */
    .bubble-container {
      flex: 1;
      display: flex;
    }

    /* burbuja de mensaje */
    .bubble {
      padding: 12px 16px;
      border-radius: 16px;
      line-height: 1.5;
      font-size: 15px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.05);
      word-break: break-word;
      max-width: 80%;
    }

    .message.user {
      justify-content: flex-start;
    }

    .message.user .bubble-container {
      justify-content: flex-start;
    }

    .message.user .bubble {
      background-color: #007bff;
      color: #fff;
      border-top-left-radius: 4px;
    }

    .message.assistant .avatar {
      order: 2; /* avatar a la derecha */
    }

    .message.assistant .bubble-container {
      justify-content: flex-end;
    }

    .message.assistant .bubble {
      background-color: #fff;
      color: #222;
      border-top-right-radius: 4px;
    }


    /* animación sutil */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }



  </style>
<% end %>

<% content_for :full_width, true %>

<div class="chat-layout">
  <header class="chat-header">
    <h1 class="h4 fw-bold text-center text-secondary mb-0">
      Chat: <%= @chat.title %>
    </h1>
  </header>

  <main id="chat-messages" class="chat-messages">
    <%= render @messages %>
  </main>

  <footer class="chat-input">
    <%= render "messages/form", chat: @chat, message: @message %>
  </footer>
</div>



<script>
  const chatBox = document.getElementById("chat-messages");
  if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;

  document.addEventListener("turbo:after-stream-render", () => {
    const chatBox = document.getElementById("chat-messages");
    if (chatBox) {
      chatBox.scrollTo({
        top: chatBox.scrollHeight,
        behavior: "smooth"
      });
    }
  });
</script>
