<div class="container py-3">
  <h1 class="h4 fw-bold text-center text-secondary mb-2">Chat: <%= @chat.title %></h1>

  <div id="chat-messages" class="p-3 border rounded bg-light mb-2"
       style="max-height: 70vh; overflow-y: auto;">
    <%= render @messages %>
  </div>

  <%= render "messages/form", chat: @chat, message: @message %>
</div>

<script>
  const chatBox = document.getElementById("chat-messages");
  if (chatBox) {
    chatBox.scrollTop = chatBox.scrollHeight;
  }

  document.addEventListener("turbo:after-stream-render", () => {
    const chatBox = document.getElementById("chat-messages");
    if (chatBox) {
      chatBox.scrollTop = chatBox.scrollHeight;
    }
  });
</script>
