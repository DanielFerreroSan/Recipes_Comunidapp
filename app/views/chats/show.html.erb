<h1>Chat ##<%= @chat.id %></h1>

<h2>Mensajes</h2>
<ul>
<% @messages.each do |message| %>
    <li style="margin-bottom: 20px;">
      <strong><%= message.user&.email || "IA" %>:</strong>
      <div><%= simple_format(message.content) %></div>

      <% if message.role == "assistant" %>
        <% # esta línea es para extraer el "titulo de la receta" %>
        <% recipe_title = message.content.match(/^###\s*(.+)$/)&.captures&.first || "Sin título" %>
        <%= button_to "Guardar receta",
          recipes_path(
          recipe: {
            name: recipe_title,
            content: message.content,
            category: "IA",
            chat_id: @chat.id
            }
          ),
        method: :post,
        class: "btn btn-success mt-2" %>
          <% end %>
    </li>
  <% end %>
</ul>

<h3>Enviar un mensaje</h3>
<%= form_with model: [@chat, @message], local: true do |form| %>
  <p>
    <%= form.label :content %><br>
    <%= form.text_area :content %>
  </p>
  <p>
    <%= form.submit "Enviar" %>
  </p>
<% end %>
