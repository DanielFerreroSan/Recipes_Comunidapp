<% content_for :stylesheets do %>
  <style data-turbo-track="reload">
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: #f0f2f5;
      font-family: 'Inter', sans-serif;
    }

    .chat-layout {
      position: relative;
      isolation: isolate; /* 👈 crea un nuevo stacking context */
      display: flex;
      flex-direction: column;
      height: calc(100vh - 56px);
      overflow: hidden;
      background: url(<%= asset_path('chat-background.png') %>) center/cover no-repeat fixed;
    }

    .chat-layout::before {
      content: "";
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.25); /* controla opacidad del velo */
      z-index: 0; /* queda debajo del contenido del chat */
    }

    .chat-layout > * {
      position: relative;
      z-index: 1; /* asegura que los mensajes y form queden sobre el velo */
    }


    .chat-header {
      flex-shrink: 0;
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.3);
      padding: 14px 0;
      text-align: center;
      position: sticky;
      top: 0;
      z-index: 2;
      box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }

    .chat-header h1 {
      margin: 0;
      font-weight: 600;
      font-size: 1.1rem;
      color: #333;
      letter-spacing: 0.2px;
      text-shadow: 0 1px 2px rgba(255, 255, 255, 0.6);
    }


    .chat-input {
      flex-shrink: 0;
      background: transparent;
      box-shadow: none;
      backdrop-filter: none;
      padding: 0px 16px 20px 16px;
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
    }


    /* Formulario interno */
    .chat-input form {
      max-width: 800px;
      width: 100%;
      display: flex;
      gap: 10px;
    }

    .chat-input textarea {
      flex: 1;
      border: 1px solid #ccc;
      border-radius: 12px;
      padding: 10px;
      resize: none;
      height: 45px;
      transition: all 0.2s;
    }

    .chat-input textarea:focus {
      border-color: #007bff;
      box-shadow: 0 0 5px rgba(0,123,255,0.3);
      outline: none;
    }

    .chat-input button {
      border: none;
      border-radius: 12px;
      background: #007bff;
      color: white;
      padding: 0 20px;
      cursor: pointer;
      font-weight: 600;
      transition: all 0.2s;
    }

    .chat-input button:hover {
      background: #0056b3;
    }

    /* ========== MENSAJES ========== */
    .chat-messages {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding: 24px 0; /* sin padding lateral para alinear al form */
      display: flex;
      flex-direction: column;
      align-items: center; /* centra la columna de conversación */
      gap: 20px;
      scroll-behavior: smooth;
      scrollbar-gutter: stable both-edges; /* scroll siempre en borde derecho */
    }

    /* contenedor individual del mensaje */


    /* ======== AVATARES ======== */
    .message {
      width: 100%;
      max-width: 800px;
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    /* avatar base */
    .avatar-circle {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      color: white;
      flex-shrink: 0;
    }

    .user-avatar {
      background-color: #5A7D7C; /* combina con burbuja */
    }

    .assistant-avatar {
      background-color: #A8B4A5; /* gris oliva */
    }

    /* contenedor de burbujas */
    .bubble-container {
      flex: 1;
      display: flex;
    }

    /* burbuja de mensaje */
    .bubble {
      padding: 12px 16px;
      border-radius: 16px;
      line-height: 1.5;
      font-size: 15px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.05);
      word-break: break-word;
      max-width: 80%;
    }

    .message.user {
      justify-content: flex-start;
    }

    .message.user .bubble-container {
      justify-content: flex-start;
    }

    .message.user .bubble {
      background-color: #5A7D7C; /* azul verdoso suave */
      color: #fff;
      border-top-left-radius: 4px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }

    .message.assistant .avatar {
      order: 2; /* avatar a la derecha */
    }

    .message.assistant .bubble-container {
      justify-content: flex-end;
    }

    .message.assistant .bubble {
      background-color: rgba(255, 255, 255, 0.9);
      color: #2b2b2b;
      border-top-right-radius: 4px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }


    /* animación sutil */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .typing-indicator {
      display: flex;
      gap: 4px;
      align-items: center;
      height: 20px;
    }

    .typing-indicator span {
      display: block;
      width: 8px;
      height: 8px;
      background-color: #ccc;
      border-radius: 50%;
      animation: typing 1s infinite ease-in-out;
    }

    .typing-indicator span:nth-child(1) {
      animation-delay: 0s;
    }
    .typing-indicator span:nth-child(2) {
      animation-delay: 0.2s;
    }
    .typing-indicator span:nth-child(3) {
      animation-delay: 0.4s;
    }

    @keyframes typing {
      0%, 80%, 100% {
        opacity: 0.3;
        transform: translateY(0);
      }
      40% {
        opacity: 1;
        transform: translateY(-3px);
      }
    }

    .loading-bubble {
      background: #fff;
      color: #333;
      font-style: italic;
    }




  </style>
<% end %>

<% content_for :full_width, true %>

<div class="chat-layout">
  <header class="chat-header d-flex align-items-center justify-content-between">
    <h1 class="h4 fw-bold px-5 text-start text-secondary mb-0">
      Chat: <%= @chat.messages.order(:created_at).first&.content&.truncate(40) || @chat.title %>
    </h1>
    <h6 class="h6 fw-normal px-5 text-muted mb-0">
      Creado el <%= @chat.created_at.strftime("%d/%m/%Y %H:%M") %>
    </h6>
  </header>

  <main id="chat-messages" class="chat-messages">
    <%= render @messages %>
  </main>

  <footer class="chat-input">
    <%= render "messages/form", chat: @chat, message: @message %>
  </footer>
</div>



<script>
  const chatBox = document.getElementById("chat-messages");
  if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;

  document.addEventListener("turbo:after-stream-render", () => {
    const chatBox = document.getElementById("chat-messages");
    if (chatBox) {
      chatBox.scrollTo({
        top: chatBox.scrollHeight,
        behavior: "smooth"
      });
    }
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const textarea = document.querySelector("#message_form .message-input");
    const form = document.getElementById("message_form");

    if (textarea && form) {
      textarea.addEventListener("keydown", function (event) {
        // Si se presiona Enter sin Shift
        if (event.key === "Enter" && !event.shiftKey) {
          event.preventDefault(); // evita el salto de línea
          form.requestSubmit();   // envía el formulario
        }
      });
    }
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("message_form");
    const textarea = form.querySelector(".message-input");
    const chatBox = document.getElementById("chat-messages");

    form.addEventListener("submit", function(event) {
      event.preventDefault();

      const content = textarea.value.trim();
      if (content === "") return;

      // Crear mensaje del usuario en el DOM de inmediato
      const userMessage = document.createElement("div");
      userMessage.classList.add("message", "user");
      userMessage.innerHTML = `
        <div class="avatar">
          <div class="avatar-circle user-avatar">U</div>
        </div>
        <div class="bubble-container">
          <div class="bubble">${content.replace(/\n/g, "<br>")}</div>
        </div>
      `;
      chatBox.appendChild(userMessage);

      // Agregar spinner para la respuesta
      const assistantMessage = document.createElement("div");
      assistantMessage.classList.add("message", "assistant");
      assistantMessage.innerHTML = `
        <div class="avatar">
          <div class="avatar-circle assistant-avatar">IA</div>
        </div>
        <div class="bubble-container">
          <div class="bubble loading-bubble">
            <div class="typing-indicator">
              <span></span><span></span><span></span>
            </div>
          </div>
        </div>
      `;
      chatBox.appendChild(assistantMessage);

      chatBox.scrollTo({ top: chatBox.scrollHeight, behavior: "smooth" });

      // Enviar el formulario por fetch (sin recargar)
      const formData = new FormData(form);
      fetch(form.action, {
        method: form.method,
        body: formData,
        headers: {
          "X-Requested-With": "XMLHttpRequest",
        },
      })
      .then(response => response.text())
      .then(html => {
        // Reemplazar el spinner con el nuevo mensaje renderizado
        const tempDiv = document.createElement("div");
        tempDiv.innerHTML = html;

        const newMessage = tempDiv.querySelector(".message.assistant");
        if (newMessage) {
          assistantMessage.replaceWith(newMessage);
        }
      })
      .catch(error => {
        console.error("Error:", error);
        assistantMessage.querySelector(".bubble").innerHTML = "⚠️ Error al cargar respuesta";
      });

      // Limpiar el textarea
      textarea.value = "";
    });
  });
</script>
