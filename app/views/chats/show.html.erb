<h1 class="chat-title">Chat #<%= @chat.id %></h1>

<div class="chat-container">
  <% @messages.each do |message| %>
    <div class="message <%= message.user.present? ? 'user-message' : 'ai-message' %>">
      <div class="bubble">
        <%= message.content %>
      </div>
    </div>
  <% end %>
</div>

<div class="message-form">
  <%= form_with model: [@chat, @message], local: true do |form| %>
    <div class="form-group">
      <%= form.text_area :content, rows: 3, placeholder: "Escribe tu mensaje..." %>
    </div>
    <div class="form-actions">
      <%= form.submit "Enviar", class: "send-btn" %>
    </div>
  <% end %>
</div>

